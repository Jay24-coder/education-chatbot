# Application
APP_ENV=development
PORT=8000

# General environment / workers
ENV=local
WORKER_CONCURRENCY=1

# Context store
CONTEXT_STORE_MODE=memory

# Queues
QUEUE_CODE_EXECUTION=code_execution
QUEUE_TOPIC_SEARCH=topic_search

# Database (legacy single URL – still supported)
DATABASE_URL=postgresql://user:password@localhost:5432/education

# Postgres (preferred granular config)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=education
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_QUEUES=1
REDIS_POOL_MAX_SIZE=10

# Vector store (optional for Phase 1)
VECTOR_DB_URL=
VECTOR_INDEX_NAME=

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
MODEL_ID=gpt-4o-mini

# Intent detection (routing)
# - keyword: use rule-based keyword matching (default)
# - llm_first: ask the LLM for a single-word intent; fall back to keyword on UNKNOWN/errors
INTENT_DETECTION_MODE=keyword
# Optional: set a separate model for intent classification; defaults to MODEL_ID when empty
INTENT_MODEL_ID=
# Keep small to avoid slowing the main /chat request path
INTENT_LLM_TIMEOUT_SECONDS=3

# Storage (optional)
STORAGE_BUCKET=
CDN_BASE_URL=

# Auth
AUTH_SECRET=
JWT_SECRET=

# Observability
TELEMETRY_ENDPOINT=
